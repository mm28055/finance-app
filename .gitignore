/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# =========================
# App data (DO NOT COMMIT)
# =========================

# App data (DO NOT COMMIT)
# =========================

# PDFs downloaded/processed by the app
*.pdf

# Data directories
data/
!data/prompt_config.json

pdfs/
uploads/
Concalls/

# Local databases
*.db

# Logs and generated outputs
*.log
*.txt
*.xlsx

# Temporary data
temp/

