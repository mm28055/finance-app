generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id              String       @id @default(uuid())
  name            String
  ticker          String       @unique
  isin            String?      @unique
  sector          String
  businessProfile String?
  aliases         String?
  isVisible       Boolean      @default(true)
  status          String       @default("ACTIVE")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  bookValue       Decimal?
  currentPrice    Decimal?
  dividendYield   Decimal?
  lastFinanceSync DateTime?
  marketCap       Decimal?
  pbRatio         Decimal?
  peRatio         Decimal?
  analyses        Analysis[]
  financials      Financials[]
  transcripts     Transcript[]
}

model Quarter {
  id          String       @id @default(uuid())
  name        String       @unique
  year        Int
  q           String
  analyses    Analysis[]
  financials  Financials[]
  transcripts Transcript[]
}

model Transcript {
  id          String   @id @default(uuid())
  companyId   String
  quarterId   String
  fileUrl     String?
  rawText     String?
  hasAnalysis Boolean  @default(false)
  createdAt   DateTime @default(now())
  quarter     Quarter  @relation(fields: [quarterId], references: [id])
  company     Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, quarterId])
}

model Financials {
  id         String   @id @default(uuid())
  companyId  String
  quarterId  String
  revenue    Decimal?
  ebitda     Decimal?
  pat        Decimal?
  revenueYoY Decimal?
  ebitdaYoY  Decimal?
  patYoY     Decimal?
  
  // New Metrics
  financeCost  Decimal?
  depreciation Decimal?
  orderBook    Decimal?
  volumeGrowth Decimal? // % growth

  // Guidance Numeric
  guidanceRevenue    Decimal? // Target Revenue
  guidanceEbitdaMargin Decimal? // Target Margin %
  guidancePat        Decimal? // Target PAT
  quarter    Quarter  @relation(fields: [quarterId], references: [id])
  company    Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, quarterId])
}

model Analysis {
  id                String   @id @default(uuid())
  companyId         String
  quarterId         String
  summary           String?
  managementTone    String?
  guidanceText      String?
  guidanceSentiment String?
  capexText         String?
  capexValue        Decimal?
  keyHighlights     String?
  deltaAnalysis     String?
  investorBrief     String?
  quarter           Quarter  @relation(fields: [quarterId], references: [id])
  company           Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, quarterId])
}

model SyncJob {
  id        String    @id @default(cuid())
  startTime DateTime  @default(now())
  endTime   DateTime?
  status    String    @default("RUNNING")
  logs      SyncLog[]
}

model SyncLog {
  id          String   @id @default(cuid())
  jobId       String
  timestamp   DateTime @default(now())
  companyName String?
  quarter     String?
  status      String
  message     String
  job         SyncJob  @relation(fields: [jobId], references: [id])
}
