generator client {
  provider = "prisma-client-js"
  // Engine: the fast in-process one by default (Vercel, GitHub Actions). This laptop sets
  // PRISMA_CLIENT_ENGINE_TYPE="binary" in .env because its chip cannot load that one.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id              String       @id @default(uuid())
  name            String
  ticker          String       @unique
  isin            String?      @unique
  sector          String
  // Listed on NSE Emerge or BSE SME rather than the main board. Set from the
  // exchanges' own scrip lists by `scripts/mark-sme.ts` — re-run it after adding
  // companies, and after a migration (SMEs graduate to the main board).
  isSme           Boolean      @default(false)
  // Held in the personal portfolio. These companies stay in their own sector and
  // are listed a second time under ZPortfolio (see lib/portfolio.ts).
  inPortfolio     Boolean      @default(false)
  businessProfile String?
  // Freshness of businessProfile. Stores the quarter NAME ("Q1 FY27") rather
  // than a Quarter FK so it survives the quarter-row cleanup. `updatedAt` can't
  // serve this purpose — it's bumped by price syncs, notes and conviction edits.
  profileQuarter   String?
  profileUpdatedAt DateTime? @db.Timestamptz(6)
  aliases         String?
  isVisible       Boolean      @default(true)
  // Hidden from the everyday view (dashboard, calendar, feeds) but still tracked in full;
  // the "Show hidden" switch brings these back. isVisible=false, by contrast, stops tracking.
  hidden          Boolean      @default(false)
  status          String       @default("ACTIVE")
  colorTag        String?      // Stores the custom color theme key (e.g. 'purple', 'emerald')
  notes           String?
  conviction      String?      // 'HIGH' | 'MEDIUM' | 'LOW' | null
  // Price the row should start celebrating at. Set by hand from the row;
  // null means no target and the price renders in its normal grey.
  targetPrice     Decimal?     @db.Decimal
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  bookValue       Decimal?     @db.Decimal
  currentPrice    Decimal?     @db.Decimal
  dividendYield   Decimal?     @db.Decimal
  // 52-week high/low, scraped from Screener's "High / Low" row alongside price.
  roce             Decimal?    @db.Decimal
  fiftyTwoWeekHigh Decimal?    @db.Decimal
  fiftyTwoWeekLow  Decimal?    @db.Decimal
  lastFinanceSync DateTime?    @db.Timestamptz(6)
  marketCap       Decimal?     @db.Decimal
  pbRatio         Decimal?     @db.Decimal
  peRatio         Decimal?     @db.Decimal
  // Trailing-twelve-month sales, summed from Screener's last four quarterly
  // columns. Stored rather than derived from `financials` because those only
  // cover quarters we hold a concall for — a third of the book has gaps there.
  // P/S is computed at read time so the daily market-cap refresh moves it
  // without a re-scrape; the sales figure itself only changes once a quarter,
  // so `lastSalesSync` lets the sweep skip it for a week at a time.
  ttmSales        Decimal?     @db.Decimal
  lastSalesSync   DateTime?    @db.Timestamptz(6)
  analyses        Analysis[]
  financials      Financials[]
  transcripts     Transcript[]
  transcriptChunks TranscriptChunk[]
  tags            CompanyTag[]
  shareholding    ShareholdingQuarter[]
}

model Quarter {
  id          String       @id @default(uuid())
  name        String       @unique
  year        Int
  q           String
  analyses    Analysis[]
  financials  Financials[]
  transcripts Transcript[]
  transcriptChunks TranscriptChunk[]
}

model Transcript {
  id          String   @id @default(uuid())
  companyId   String
  quarterId   String
  fileUrl     String?
  rawText     String?
  hasAnalysis Boolean  @default(false)
  // The concall event this document came from. Identity for the sync: Tijori can
  // list several documents inside one quarter (an investor meet, a related
  // entity's call, the company's own results call), and without the event date
  // the only way to tell "already have this one" from "this is a different
  // document" was its position in the list — which put IRB's InvIT call in the
  // quarter slot and the company's real Q1 FY27 call in a General slot.
  sourceEventDate DateTime? @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  filePath    String?
  company     Company  @relation(fields: [companyId], references: [id])
  quarter     Quarter  @relation(fields: [quarterId], references: [id])

  @@unique([companyId, quarterId])
}

model Financials {
  id                   String   @id @default(uuid())
  companyId            String
  quarterId            String
  revenue              Decimal? @db.Decimal
  ebitda               Decimal? @db.Decimal
  pat                  Decimal? @db.Decimal
  revenueYoY           Decimal? @db.Decimal
  ebitdaYoY            Decimal? @db.Decimal
  patYoY               Decimal? @db.Decimal
  depreciation         Decimal? @db.Decimal
  financeCost          Decimal? @db.Decimal
  guidanceEbitdaMargin Decimal? @db.Decimal
  guidancePat          Decimal? @db.Decimal
  guidanceRevenue      Decimal? @db.Decimal
  orderBook            Decimal? @db.Decimal
  volumeGrowth         Decimal? @db.Decimal
  company              Company  @relation(fields: [companyId], references: [id])
  quarter              Quarter  @relation(fields: [quarterId], references: [id])

  @@unique([companyId, quarterId])
}

model Analysis {
  id                String   @id @default(uuid())
  companyId         String
  quarterId         String
  summary           String?
  managementTone    String?
  guidanceText      String?
  guidanceSentiment String?
  capexText         String?
  capexValue        Decimal? @db.Decimal
  keyHighlights     String?
  deltaAnalysis     String?
  investorBrief     String?
  investibilityScore Int?     // 0-100 Score by Gemini Senior Analyst
  // Forward revenue guidance, read back out of `investorBrief` by
  // scripts/extract-guidance.ts. Stored as a range because managements guide in
  // ranges ("15-20%"); a single figure sets both ends. Lives on Analysis rather
  // than Company so the number always travels with the quarter that said it —
  // that is what makes "use the latest quarter" and staleness free.
  guidanceGrowthMin Decimal? @db.Decimal
  guidanceGrowthMax Decimal? @db.Decimal
  guidanceFy        String?  // fiscal year the guidance covers, e.g. "FY27"
  guidanceBasis     String?  // 'STATED' | 'IMPLIED' | 'NONE'
  guidanceQuote     String?  // verbatim sentence, so any green name is traceable
  company           Company  @relation(fields: [companyId], references: [id])
  quarter           Quarter  @relation(fields: [quarterId], references: [id])

  @@unique([companyId, quarterId])
}

model SyncJob {
  id        String    @id @default(cuid())
  startTime DateTime  @default(now()) @db.Timestamptz(6)
  endTime   DateTime? @db.Timestamptz(6)
  status    String    @default("RUNNING")
  logs      SyncLog[]
}

model SyncLog {
  id          String   @id @default(cuid())
  jobId       String
  timestamp   DateTime @default(now()) @db.Timestamptz(6)
  companyName String?
  quarter     String?
  status      String
  message     String?
  job         SyncJob  @relation(fields: [jobId], references: [id])
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

model SectorChat {
  id        String   @id @default(uuid())
  sector    String   // e.g. "Defense", "Banking"
  role      String   // "user" or "assistant"
  content   String   // The text message
  timestamp BigInt   // Unix timestamp for ordering
  createdAt DateTime @default(now())
  
  @@index([sector])
}

model TranscriptChunk {
  id        String   @id @default(uuid())
  content   String
  embedding Unsupported("vector(768)")? // Gemini 1.5/Pro embedding dimension

  sector    String
  companyId String
  quarterId String
  
  company   Company @relation(fields: [companyId], references: [id])
  quarter   Quarter @relation(fields: [quarterId], references: [id])

  createdAt DateTime @default(now())

  @@index([sector])
  @@index([companyId])
}

// Free-form notes. `scope` is "SECTOR" (key = sector name) or "GENERAL"
// (key = "__general__"), so one table backs both the per-sector notepad and
// the global one.
model Note {
  id        String   @id @default(uuid())
  scope     String
  key       String
  // Only general notes carry a user-chosen name. Sector notes are named after
  // their sector, so they leave this null.
  title     String?
  content   String   @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([scope, key])
}

// The owner's own labels for a company ("defence-core", "watch-q2"), set from the
// opened row and used as a filter on the dashboard. Private: read and written
// only when signed in.
model CompanyTag {
  id        String   @id @default(uuid())
  companyId String
  tag       String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, tag])
  @@index([tag])
}

// Quarterly shareholding pattern, as Screener labels the columns ("Sep 2026").
// Filled by scripts/sync-finance.js from the page it already downloads; the
// last 12 periods are kept. `pledged` is the share of the promoter holding
// pledged, from the NSE shareholding filing (scripts/sync-corporate-actions.ts).
// All figures are percentages. Read with raw SQL (lib/shareholding.ts).
model ShareholdingQuarter {
  id           String   @id @default(uuid())
  companyId    String
  period       String
  periodEnd    DateTime @db.Date
  promoter     Decimal  @db.Decimal
  fii          Decimal  @db.Decimal
  dii          Decimal  @db.Decimal
  government   Decimal  @db.Decimal
  public       Decimal  @db.Decimal
  shareholders Int?
  pledged      Decimal? @db.Decimal
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period])
  @@index([companyId, periodEnd])
}
