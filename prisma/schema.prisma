generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id              String       @id @default(uuid())
  name            String
  ticker          String       @unique
  isin            String?      @unique
  sector          String
  businessProfile String?
  aliases         String?
  isVisible       Boolean      @default(true)
  status          String       @default("ACTIVE")
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  bookValue       Decimal?     @db.Decimal
  currentPrice    Decimal?     @db.Decimal
  dividendYield   Decimal?     @db.Decimal
  lastFinanceSync DateTime?    @db.Timestamptz(6)
  marketCap       Decimal?     @db.Decimal
  pbRatio         Decimal?     @db.Decimal
  peRatio         Decimal?     @db.Decimal
  analyses        Analysis[]
  financials      Financials[]
  transcripts     Transcript[]
}

model Quarter {
  id          String       @id @default(uuid())
  name        String       @unique
  year        Int
  q           String
  analyses    Analysis[]
  financials  Financials[]
  transcripts Transcript[]
}

model Transcript {
  id          String   @id @default(uuid())
  companyId   String
  quarterId   String
  fileUrl     String?
  rawText     String?
  hasAnalysis Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  filePath    String?
  company     Company  @relation(fields: [companyId], references: [id])
  quarter     Quarter  @relation(fields: [quarterId], references: [id])

  @@unique([companyId, quarterId])
}

model Financials {
  id                   String   @id @default(uuid())
  companyId            String
  quarterId            String
  revenue              Decimal? @db.Decimal
  ebitda               Decimal? @db.Decimal
  pat                  Decimal? @db.Decimal
  revenueYoY           Decimal? @db.Decimal
  ebitdaYoY            Decimal? @db.Decimal
  patYoY               Decimal? @db.Decimal
  depreciation         Decimal? @db.Decimal
  financeCost          Decimal? @db.Decimal
  guidanceEbitdaMargin Decimal? @db.Decimal
  guidancePat          Decimal? @db.Decimal
  guidanceRevenue      Decimal? @db.Decimal
  orderBook            Decimal? @db.Decimal
  volumeGrowth         Decimal? @db.Decimal
  company              Company  @relation(fields: [companyId], references: [id])
  quarter              Quarter  @relation(fields: [quarterId], references: [id])

  @@unique([companyId, quarterId])
}

model Analysis {
  id                String   @id @default(uuid())
  companyId         String
  quarterId         String
  summary           String?
  managementTone    String?
  guidanceText      String?
  guidanceSentiment String?
  capexText         String?
  capexValue        Decimal? @db.Decimal
  keyHighlights     String?
  deltaAnalysis     String?
  investorBrief     String?
  company           Company  @relation(fields: [companyId], references: [id])
  quarter           Quarter  @relation(fields: [quarterId], references: [id])

  @@unique([companyId, quarterId])
}

model SyncJob {
  id        String    @id @default(cuid())
  startTime DateTime  @default(now()) @db.Timestamptz(6)
  endTime   DateTime? @db.Timestamptz(6)
  status    String    @default("RUNNING")
  logs      SyncLog[]
}

model SyncLog {
  id          String   @id @default(cuid())
  jobId       String
  timestamp   DateTime @default(now()) @db.Timestamptz(6)
  companyName String?
  quarter     String?
  status      String
  message     String?
  job         SyncJob  @relation(fields: [jobId], references: [id])
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}
